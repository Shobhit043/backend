<%
  // Works whether or not the parent view passes `name`.
  var currentUser = (typeof name !== 'undefined' && name) ? name : '';
%>
<nav class="navbar navbar-expand-lg navbar-light app-navbar sticky-top">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/">
      <span class="brand-mark">B</span>
      <span>Blogify</span>
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
        <li class="nav-item">
          <a class="nav-link" href="/">Home</a>
        </li>
        <% if (currentUser) { %>
        <li class="nav-item">
          <a class="nav-link" href="/blog/add-blog">Write</a>
        </li>
        <% } %>
      </ul>
      <ul class="navbar-nav align-items-lg-center gap-lg-2 mb-2 mb-lg-0">
        <% if (currentUser) { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="navbarDropdown" role="button"
            data-bs-toggle="dropdown" aria-expanded="false">
            <span class="d-none d-sm-inline"><%= currentUser %></span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="navbarDropdown">
            <li>
              <form action="/user/signout" method="POST" class="m-0">
                <button type="submit" class="dropdown-item">Sign out</button>
              </form>
            </li>
          </ul>
        </li>
        <% } else { %>
        <li class="nav-item">
          <a class="nav-link" href="/user/signin">Sign in</a>
        </li>
        <li class="nav-item">
          <a class="btn btn-primary btn-sm px-3" href="/user/signup">Sign up</a>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>