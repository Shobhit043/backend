<style>
  :root {
    --app-bg: #f7f8fa;
    --app-surface: #ffffff;
    --app-border: #e9edf2;
    --app-text: #1f2937;
    --app-muted: #6b7280;
    --app-accent: #2563eb;
    --app-radius: 0.85rem;
    --app-shadow-sm: 0 1px 2px rgba(16, 24, 40, 0.05);
    --app-shadow-md: 0 10px 25px rgba(16, 24, 40, 0.08);
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background-color: var(--app-bg);
    color: var(--app-text);
    -webkit-font-smoothing: antialiased;
  }

  /* Navbar */
  .app-navbar {
    background-color: rgba(255, 255, 255, 0.9) !important;
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--app-border);
    box-shadow: var(--app-shadow-sm);
  }
  .navbar-brand { letter-spacing: -0.02em; }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 0.55rem;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 800;
  }

  /* Page headings */
  .page-title { letter-spacing: -0.025em; font-weight: 800; }
  .page-subtitle { color: var(--app-muted); }

  /* Blog cards */
  .blog-card {
    border: 1px solid var(--app-border);
    border-radius: var(--app-radius);
    overflow: hidden;
    background-color: var(--app-surface);
    box-shadow: var(--app-shadow-sm);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--app-shadow-md);
    border-color: #dbe3ee;
  }
  .blog-card .ratio img {
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .blog-card:hover .ratio img { transform: scale(1.05); }

  .blog-card-title {
    font-weight: 700;
    line-height: 1.35;
    color: var(--app-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card-excerpt {
    color: var(--app-muted);
    font-size: 0.875rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card-meta { font-size: 0.8rem; color: var(--app-muted); }

  /* Empty state */
  .empty-state {
    background: var(--app-surface);
    border: 1px dashed #d5dbe4;
    border-radius: var(--app-radius);
    padding: 3rem 1.5rem;
    text-align: center;
  }

  /* Article page */
  .article-title { letter-spacing: -0.03em; font-weight: 800; }
  .article-cover {
    border-radius: var(--app-radius);
    box-shadow: var(--app-shadow-md);
  }
  .blog-content {
    white-space: pre-line;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #374151;
  }

  /* Forms */
  .form-card {
    background: var(--app-surface);
    border: 1px solid var(--app-border);
    border-radius: var(--app-radius);
    box-shadow: var(--app-shadow-sm);
  }
  .form-label { font-weight: 600; font-size: 0.9rem; }
  .form-control { border-color: #dbe1ea; padding: 0.6rem 0.85rem; }
  .form-control:focus {
    border-color: var(--app-accent);
    box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.15);
  }

  /* Auth pages */
  .auth-wrapper { min-height: calc(100vh - 72px); }

  @media (prefers-reduced-motion: reduce) {
    .blog-card, .blog-card .ratio img { transition: none; }
    .blog-card:hover { transform: none; }
    .blog-card:hover .ratio img { transform: none; }
  }
</style>