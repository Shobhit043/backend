<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head.ejs') -%>
    <title>
      Homepage
    </title>
</head>

<body>
  <%- include('./partials/navbar.ejs')-%>

  <main class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <h1 class="page-title h2 mb-1">Recent Blogs</h1>
        <p class="page-subtitle mb-0">Latest stories from the community</p>
      </div>
      <a href="/blog/add-blog" class="btn btn-primary px-3">Write a blog</a>
    </div>

    <% if (blogs && blogs.length > 0) { %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
        <% blogs.forEach(function (blog) { %>
          <div class="col">
            <a href="/blog/<%= blog._id %>" class="text-decoration-none d-block h-100">
              <article class="card blog-card h-100">
                <div class="ratio ratio-16x9 bg-light">
                  <img src="<%= blog.coverImageURL || '/images/placeholder.svg' %>" alt="<%= blog.title %>">
                </div>
                <div class="card-body d-flex flex-column">
                  <h2 class="blog-card-title h6 mb-2"><%= blog.title %></h2>
                  <p class="blog-card-excerpt mb-3">
                    <%= blog.content ? (blog.content.length > 160 ? blog.content.substring(0, 160) + '…' : blog.content) : '' %>
                  </p>
                  <div class="mt-auto d-flex justify-content-between align-items-center blog-card-meta">
                    <span class="text-truncate me-2"><%= blog.createdBy ? blog.createdBy.name : 'Unknown' %></span>
                    <span class="text-nowrap"><%= blog.createdAt ? blog.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '' %></span>
                  </div>
                </div>
              </article>
            </a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p class="text-muted mb-3">No blogs yet. Be the first to share a story.</p>
        <a href="/blog/add-blog" class="btn btn-primary px-3">Create your first blog</a>
      </div>
    <% } %>
  </main>

  <%- include('./partials/scripts.ejs') -%>
</body>
</html>