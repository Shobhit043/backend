<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head.ejs') -%>
    <title>
      Add Blog
    </title>
</head>

<body>
  <%- include('./partials/navbar.ejs')-%>

  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-8">
        <div class="mb-4">
          <h1 class="page-title h2 mb-1">Write a blog</h1>
          <p class="page-subtitle mb-0">Share your story with the community</p>
        </div>

        <div class="form-card p-4 p-md-5">
          <form method="post" action="/blog/add-new" enctype="multipart/form-data">
            <div class="mb-4">
              <label for="title" class="form-label">Title</label>
              <input type="text" class="form-control" id="title" name="title" placeholder="An interesting title" required>
            </div>

            <div class="mb-4">
              <label for="content" class="form-label">Content</label>
              <textarea class="form-control" id="content" name="content" rows="10"
                placeholder="Write your story..." required></textarea>
            </div>

            <div class="mb-4">
              <label for="coverImage" class="form-label">Cover image</label>
              <input type="file" class="form-control" id="coverImage" name="coverImage" accept="image/*">
              <div class="form-text">Optional. JPEG, PNG, GIF, WebP or AVIF up to 3 MB.</div>
            </div>

            <img id="coverPreview" src="" alt="Cover preview" class="img-fluid rounded mb-4 d-none">

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary px-4">Publish</button>
              <a href="/" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <%- include('./partials/scripts.ejs') -%>

  <script>
    (function () {
      var input = document.getElementById('coverImage');
      var preview = document.getElementById('coverPreview');
      var currentUrl = null;

      input.addEventListener('change', function () {
        if (currentUrl) {
          URL.revokeObjectURL(currentUrl);
          currentUrl = null;
        }
        var file = input.files && input.files[0];
        if (!file) {
          preview.classList.add('d-none');
          return;
        }
        currentUrl = URL.createObjectURL(file);
        preview.src = currentUrl;
        preview.classList.remove('d-none');
      });
    })();
  </script>
</body>
</html>